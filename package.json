{
  "name": "wattguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:frontend dev:backend",
    "dev:frontend": "bunx --bun vite",
    "dev:backend": "bun --watch src/index.ts",
    "simulate": "bun --watch scripts/simulator.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "vite build && bun run build.ts",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist",
    "check": "tsgo --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/standard-validator": "0.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@scalar/hono-api-reference": "0.9.38",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-query-devtools": "^5.100.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.0",
    "hono": "^4.12.15",
    "hono-openapi": "^1.3.0",
    "hono-rate-limiter": "^0.5.3",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "mongoose": "^9.5.0",
    "mqtt": "^5.15.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "^4.10.0",
    "react-router-dom": "^7.14.2",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "latest",
    "@types/leaflet": "^1.9.21",
    "@types/mqtt": "^2.5.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260427.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.4",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.2"
  }
