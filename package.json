{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"bun run --watch src/index.ts\"",
    "dev:frontend": "vite",
    "dev:backend": "bun run --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "vite build && bun run build.ts",
    "test": "bun test",
    "test:unit": "bun test src/__tests__/utils/",
    "test:integration": "NODE_ENV=test bun test src/__tests__/routes/",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.10.7",
    "hono-rate-limiter": "^0.5.3",
    "lucide-react": "^0.545.0",
    "mongoose": "^9.0.0",
    "nodemailer": "^7.0.13",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "latest",
    "@types/node": "^25.0.10",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.1"
  }
}
