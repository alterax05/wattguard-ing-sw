{
  "name": "wattguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "shared"],
  "trustedDependencies": ["mongodb-memory-server"],
  "scripts": {
    "dev": "bun run --parallel dev:frontend dev:backend",
    "dev:frontend": "bun run --cwd apps/web dev",
    "dev:backend": "bun run --cwd apps/api dev",
    "simulate": "bun run --cwd apps/api simulate",
    "start": "bun run --cwd apps/api start",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/api build && cp -r apps/web/dist apps/api/dist/web",
    "test": "bun run --cwd apps/api test",
    "test:watch": "bun run --cwd apps/api test:watch",
    "clean": "rm -rf apps/web/dist apps/api/dist",
    "check": "bun run --cwd apps/web check && bun run --cwd apps/api check && bun run --cwd shared check",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "bson": "7.2.0"
  }
}
