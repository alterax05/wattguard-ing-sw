# MongoDB
MONGO_URI=mongodb://localhost:27017/wattguard

# Tests use an in-memory MongoDB automatically; no MONGO_URI needed.

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_ENABLED=false

# Simulator 
SIMULATOR_ENABLED=false
SIM_TIME_SCALE=2
# How often (ms) the in-process simulator re-queries the DB for new sensors.
# Lower it (e.g. 10000) on Render free-tier so it recovers faster after a wake.
SIM_DISCOVERY_INTERVAL_MS=60000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Google OAuth (Sign in with Google - GSI)
GOOGLE_CLIENT_ID=your-google-client-id

# Public application URL
PUBLIC_APP_URL=http://localhost:5173

# Email (Resend HTTP API)
RESEND_API=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
