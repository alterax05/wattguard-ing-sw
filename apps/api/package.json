{
  "name": "@wattguard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build.ts",
    "start": "NODE_ENV=production bun dist/index.js",
    "simulate": "bun --watch scripts/simulator.ts",
    "test": "bun test --parallel --timeout 20000",
    "test:watch": "bun test --watch",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "0.9.38",
    "@wattguard/shared": "workspace:*",
    "exceljs": "^4.4.0",
    "hono-openapi": "^1.3.1",
    "hono-rate-limiter": "^0.5.3",
    "mongoose": "9.9.1",
    "mqtt": "^5.15.2",
    "pdfkit": "^0.19.1",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mqtt": "^2.5.0",
    "@types/node": "^25.9.5",
    "@types/pdfkit": "^0.17.6",
    "mongodb-memory-server": "^10.4.3",
    "typescript": "^7.0.2"
  }
}
